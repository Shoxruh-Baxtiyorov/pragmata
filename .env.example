# скопируй в .env и поправь под себя
APP_ENV=development
DATABASE_URL=postgresql+psycopg://soqchi:soqchi@127.0.0.1:5433/soqchi
MEDIA_DIR=./data/media
MODELS_DIR=./models
# ОБЯЗАТЕЛЕН вне APP_ENV=test (шифрование RTSP-кредов в БД). Потеря ключа =
# потеря всех зашифрованных значений — бэкапь как секрет. Сгенерировать:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Telegram-алерты: токен бота от @BotFather; пусто = бот выключен.
TELEGRAM_BOT_TOKEN=
# Кому слать алерты (secure default: только эти чаты). Свой chat_id бот скажет на /start.
TELEGRAM_CHAT_IDS=
# LLM-агент (свободные вопросы в боте). Пустой LLM_API_KEY = выключен;
# /digest и /find работают и без него. Два пресета:
#   локально/бесплатно (Ollama):  LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:3b
#   облако (OpenRouter):          LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=sk-...  LLM_MODEL=google/gemini-2.0-flash-001
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-2.0-flash-001
# VLM-описания alert-карточек (тот же endpoint). Локально: qwen2.5vl:3b (ollama pull).
# В облаке ставь мультимодальную (например ту же gemini) . Пусто = выключено.
VLM_MODEL=qwen2.5vl:3b
VLM_MAX_PER_HOUR=60
# Распознавание лица для watchlist (insightface buffalo_s ~90МБ, CPU, офлайн).
# Точнее одежды: ловит человека даже переодетым. Модель качается один раз при
# первом лице; нет пакета/модели/сети → тихо выключается (fallback на CLIP-тело).
FACE_RECOGNITION=1
# Детекция оружия: та же VLM проверяет кадр каждого входящего человека (свой бюджет).
# Требует VLM (LLM_API_KEY + VLM_MODEL). Точность зависит от модели — офлайн qwen2.5vl:3b
# ловит явное оружие в руках; сомнительное лучше пропустит, чем ложно тревожит.
WEAPON_DETECTION=0
WEAPON_MAX_PER_HOUR=120
# Детекция транспорта + номера (ANPR): YOLO ловит машины (car/bus/truck/moto),
# OCR читает номер best-effort. Чтение номера требует `uv sync --extra anpr`
# (easyocr); без него — только тип и факт появления транспорта.
VEHICLE_DETECTION=0
VEHICLE_CONF=0.3
# Детектор: yolo11n.pt (скорость) | yolo11s.pt (recall в группах людей)
YOLO_MODEL=yolo11n.pt
# --- Dashboard API (uv run uvicorn soqchi.api.app:app --port 8088) ---
# SECRET_KEY обязателен (JWT), иначе вход/проверка токена → 503 (fail-closed).
# SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Пользователи: логин username+пароль (argon2id). Первого админа заводит CLI:
#   uv run python scripts/create_user.py --username admin --password '...' --role admin
# (env-входа по ADMIN_PASSWORD больше нет — удалён по аудиту безопасности)
SITE_CONFIG=config/dev.yaml
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
# /find в API грузит CLIP вторым процессом (~600МБ RAM) — включать осознанно
API_ENABLE_FIND=0
