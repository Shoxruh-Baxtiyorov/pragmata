# скопируй в .env и поправь под себя
APP_ENV=development
DATABASE_URL=postgresql+psycopg://soqchi:soqchi@127.0.0.1:5433/soqchi
MEDIA_DIR=./data/media
MODELS_DIR=./models
# ОБЯЗАТЕЛЕН вне APP_ENV=test (шифрование RTSP-кредов в БД). Потеря ключа =
# потеря всех зашифрованных значений — бэкапь как секрет. Сгенерировать:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Telegram-алерты: токен бота от @BotFather; пусто = бот выключен.
TELEGRAM_BOT_TOKEN=
# Кому слать алерты (secure default: только эти чаты). Свой chat_id бот скажет на /start.
TELEGRAM_CHAT_IDS=
# LLM-агент (свободные вопросы в боте). Пусто = выключен; /digest и /find работают и так.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Детектор: yolo11n.pt (скорость) | yolo11s.pt (recall в группах людей)
YOLO_MODEL=yolo11n.pt
